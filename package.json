{
  "name": "@revenuedot/monetization-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Skills and a read-only knowledge server that let a coding agent plan, price, build and test an app's subscriptions and paywall. Maintained by RevenueDot.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://revenuedot.app/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/revenuedot/monetization-kit.git"
  },
  "bin": {
    "monetization-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "kit.json",
    "data",
    "plugins",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts --http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-name": "node scripts/sync-name.mjs",
    "check-data": "node scripts/check-data.mjs",
    "check-data:offline": "node scripts/check-data.mjs --offline"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
